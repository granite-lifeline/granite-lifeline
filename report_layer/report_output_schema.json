{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "risk_score",
    "risk_level",
    "component",
    "prediction_confidence",
    "key_signals",
    "anomaly_description",
    "possible_cause",
    "recommended_action",
    "notes"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["Low", "Medium", "High"]
    },
    "component": {
      "type": "string",
      "enum": [
        "cooling_degradation",
        "air_intake_maf_anomaly",
        "accelerator_pedal_sensor",
        "intake_air_temperature_sensor_or_heat_soak_fault",
        "map_load_signal_plausibility_fault",
        "electronic_throttle_tracking_fault",
        "idle_speed_control_or_surge_degradation"
      ]
    },
    "prediction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "key_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "value", "unit", "reference_range"],
        "properties": {
          "feature": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "reference_range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "estimated_cycles_to_failure": {
      "type": ["integer", "null"],
      "description": "Estimated number of drive cycles before component failure, provided by Model Layer"
    },
    "estimated_failure_probability": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Probability of component failure (0.0-1.0), provided by Model Layer"
    },
    "risk_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "risk_score"],
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "risk_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "anomaly_description": {
      "type": "string"
    },
    "possible_cause": {
      "type": "string"
    },
    "recommended_action": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Input validation and degradation messages from Model Layer"
    }
  }
}
