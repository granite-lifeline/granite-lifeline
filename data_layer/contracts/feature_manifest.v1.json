      "trip_definition": "one discovered raw KIT CSV file equals one trip/drive cycle",
      "source_file_merge_forbidden": true,
      "trip_start_timestamp_utc": "minimum valid source timestamp after combining filename date with in-file time, applying the configured source timezone, and converting to UTC",
      "source_file_order": [
        "trip_start_timestamp_utc ascending",
        "source_filename ascending"
      ],
      "trip_id_assignment": "1-based ordinal in source_file_order, formatted as trip_<zero-padded ordinal> with minimum width 4",
      "deterministic_for_fixed_source_dataset_identity": true,
      "filesystem_discovery_order_must_not_affect_assignment": true,
      "dataset_membership_change_may_renumber_trips": true
    },
    "row_order_contract": {
      "timestamp_normalization": "UTC",
      "stable_sort_ascending": [
        "timestamp",
        "trip_id",
        "segment_id",
        "row_in_segment"
      ],
      "timestamp_is_primary_global_chronological_key": true,
      "remaining_keys_are_deterministic_tie_breakers": true,
      "within_trip_segment": {
        "row_in_segment": "1-based and strictly increasing",
        "timestamp": "strictly increasing at canonical 1 Hz cadence"
      },
      "join_order_must_be_explicitly_restored": true,
      "windows_must_not_cross": [
        "trip_id",
        "segment_id"
      ]
    }
  },
